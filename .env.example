# Offline remains the deterministic default.
NPC_AGENT_MODEL=offline

# Required when NPC_AGENT_MODEL=live.
# Supported: openai, deepseek, opencode_go, openai_compatible.
NPC_LLM_PROVIDER=openai
NPC_LLM_MODEL=
NPC_LLM_API_KEY=

# Optional live settings.
NPC_LLM_BASE_URL=
# Usually omitted. Needed for unknown gateway models or an explicit override.
NPC_LLM_TRANSPORT=
# Optional explicit capability: json_schema, json_object, or none.
NPC_LLM_STRUCTURED_OUTPUT=
NPC_LLM_TIMEOUT_SECONDS=30
NPC_LLM_MAX_RETRIES=2
