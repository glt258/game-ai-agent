{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-skill-s2-shadow-full-input-tiny-output/0.1.0",
  "title": "CS-S2 Full-Input Tiny-Output Latency Isolation Bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "character-skill-s2-shadow-full-input-tiny-output/0.1.0"},
    "protocol_version": {"type": "string"},
    "run_id": {"type": "string"},
    "experiment_type": {"const": "full_input_tiny_output"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "array", "minItems": 1},
    "provider": {"type": "object"},
    "case_id": {"const": "case_13"},
    "timeout_seconds": {"const": 60},
    "max_transport_retries": {"const": 0},
    "target_sample_count": {"const": 1},
    "complete": {"const": true},
    "input_contract_version": {"type": "string"},
    "tiny_output_contract_version": {"type": "string"},
    "historical_full_input": {"type": "object"},
    "request_metrics": {"type": "object"},
    "sample_index": {"const": 1},
    "observation": {"type": "object"},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "schema_version", "protocol_version", "run_id", "experiment_type", "source_commit",
    "manifest_digest", "input_manifest_digest", "inputs", "provider", "case_id",
    "timeout_seconds", "max_transport_retries", "target_sample_count", "complete",
    "input_contract_version", "tiny_output_contract_version", "historical_full_input",
    "request_metrics", "sample_index", "observation", "bundle_digest"
  ]
}
