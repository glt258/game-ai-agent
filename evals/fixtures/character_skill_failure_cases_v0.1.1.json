  "cases": [
    {
      "id": "skill_s0_01_resource_loop_complete",
      "title": "完整资源循环",
      "category": "resource_loop",
      "request": {
        "brief": "设计一个围绕可回收专属标记展开的角色技能组概念。",
        "hard_constraints": [
          "标记必须由角色的明确行动产生并被另一明确行动消耗",
          "标记离场时必须有清理或转化关系",
          "没有标记时仍要有可理解的基础行动路径"
        ],
        "forbidden_elements": [
          "未请求的第二套专属资源"
        ],
        "combat_role_profile": null
      },
      "candidate_observation": {
        "summary": "候选明确描述了标记如何产生、被消耗、在场景离开时清理，并保留无标记行动。",
        "declared_facts": [
          "明确行动会产生专属标记",
          "另一明确行动消耗专属标记并改变结果",
          "没有标记时基础行动仍然成立",
          "场景离开会清理未消耗标记"
        ],
        "signals": [
          "resource_enter_relation_present",
          "resource_spend_relation_present",
          "resource_exit_relation_present"
        ]
      },
      "expected": {
        "outcome": "PASS",
        "blocking": false,
        "repair_allowed": false,
        "findings": []
      },
      "coverage_tags": [
        "resource_loop",
        "pass_control"
      ],
      "rationale": "资源从进入到离开有可追踪关系，且未增加请求外的资源系统。"
    },
