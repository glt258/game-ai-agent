{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-skill-s2-shadow-evidence/0.2.1",
  "title": "Character Skill CS-S2 Shadow Evidence Run Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "protocol_version",
    "source_commit",
    "input_manifest_digest",
    "inputs",
    "provider",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": "character-skill-s2-shadow-evidence/0.2.1"},
    "run_id": {
      "type": "string",
      "pattern": "^cs-s2-shadow-deepseek-v0\\.2\\.1-[0-9a-f]{40}-[0-9a-f]{12}-run-0[1-3]$"
    },
    "protocol_version": {"const": "0.2.1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/input"}
    },
    "provider": {"$ref": "#/$defs/provider"},
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "enum": ["provider", "evaluator", "oracle-only"]}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model_requested",
        "model_reported",
        "transport",
        "structured_output_mode",
        "response_contract",
        "candidate_schema_version",
        "timeout_seconds",
        "max_transport_retries"
      ],
      "properties": {
        "name": {"const": "opencode_go"},
        "model_requested": {"const": "deepseek-v4-flash"},
        "model_reported": {"type": ["string", "null"]},
        "transport": {"const": "openai_chat_completions"},
        "structured_output_mode": {"const": "json_object"},
        "response_contract": {"const": "character_skill_kit"},
        "candidate_schema_version": {"const": "skill-kit-candidate/0.1.1"},
        "timeout_seconds": {"const": 30},
        "max_transport_retries": {"const": 2}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_digest", "observation", "audit", "sanitization"],
      "properties": {
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observation": {"$ref": "#/$defs/observation"},
        "audit": {"$ref": "#/$defs/audit"},
        "sanitization": {"$ref": "#/$defs/sanitization"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "case_id",
        "repeat",
        "draft_id",
        "transport_outcome",
        "failure_stage",
        "failure_code",
        "shape_compliant",
        "parse_outcome",
        "outcome",
        "finding_codes",
        "candidate_digest",
        "context_digest",
        "report_digest",
        "renderer_comparison",
        "legacy_impact"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "pattern": "^case_(?:0[1-9]|1[0-9])$"},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 3},
        "draft_id": {"type": "string", "minLength": 1},
        "transport_outcome": {"enum": ["success", "failure"]},
        "failure_stage": {
          "type": ["string", "null"],
          "enum": [null, "context", "provider", "json", "shape", "validation", "runner"]
        },
        "failure_code": {
          "type": ["string", "null"],
          "enum": [null, "CONTEXT_INVALID", "PROVIDER_INVOCATION_FAILED", "RESPONSE_JSON_INVALID", "CANDIDATE_SHAPE_REJECTED", "EVALUATION_FAILED", "RUNNER_FAILURE"]
        },
        "shape_compliant": {"type": "boolean"},
        "parse_outcome": {"enum": ["parsed", "rejected", "not_attempted"]},
        "outcome": {"enum": ["PASS", "REPAIR", "FAIL", "UNAVAILABLE"]},
        "finding_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "candidate_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "context_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "report_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "renderer_comparison": {"$ref": "#/$defs/renderer"},
        "legacy_impact": {"const": false}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "matches_legacy", "summary_code"],
      "properties": {
        "performed": {"const": false},
        "matches_legacy": {"type": "null"},
        "summary_code": {"const": "not_authoritative"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redacted_request_id", "retry_count", "latency_ms", "token_usage"],
      "properties": {
        "redacted_request_id": {"type": "string", "pattern": "^redacted:[0-9a-f]{16}$"},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "token_usage": {"$ref": "#/$defs/token_usage"}
      }
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_prompt_stored", "raw_response_stored", "secrets_detected"],
      "properties": {
        "raw_prompt_stored": {"const": false},
        "raw_response_stored": {"const": false},
        "secrets_detected": {"const": false}
      }
    }
  }
}
