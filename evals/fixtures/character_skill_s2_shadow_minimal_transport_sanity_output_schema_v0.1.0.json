{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-skill-s2-shadow-minimal-transport-sanity/0.1.0",
  "title": "CS-S2 OpenCode Go Minimal Transport Sanity Bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "character-skill-s2-shadow-minimal-transport-sanity/0.1.0"},
    "protocol_version": {"type": "string"},
    "run_id": {"type": "string"},
    "experiment_type": {"const": "minimal_transport_sanity"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "array", "minItems": 1},
    "provider": {"type": "object"},
    "timeout_seconds": {"const": 60},
    "max_transport_retries": {"const": 0},
    "target_sample_count": {"const": 1},
    "complete": {"const": true},
    "tiny_contract_version": {"const": "minimal-status-object/0.1.0"},
    "sample_index": {"const": 1},
    "observation": {"type": "object"},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "schema_version", "protocol_version", "run_id", "experiment_type",
    "source_commit", "manifest_digest", "input_manifest_digest", "inputs",
    "provider", "timeout_seconds", "max_transport_retries", "target_sample_count",
    "complete", "tiny_contract_version", "sample_index", "observation", "bundle_digest"
  ]
}
